Windows Registry Editor Version 5.00

; Suppress 7z.exe console from Windows Open With menus
[HKEY_CURRENT_USER\Software\Classes\Applications\7z.exe]
"NoOpenWith"=""

; VXArchive Application Registration & Supported Types
[HKEY_CURRENT_USER\Software\Classes\Applications\VXArchive.exe]
@="VXArchive"
"FriendlyAppName"="VXArchive"
"ApplicationCompany"="VXArchive Studio"

[HKEY_CURRENT_USER\Software\Classes\Applications\VXArchive.exe\DefaultIcon]
@="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\Applications\VXArchive.exe\shell\open\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Applications\VXArchive.exe\SupportedTypes]
".zip"=""
".7z"=""
".rar"=""
".tar"=""
".gz"=""
".bz2"=""
".xz"=""
".iso"=""
".cab"=""
".wim"=""
".tgz"=""
".tbz2"=""
".txz"=""

; VXArchive File Type ProgID
[HKEY_CURRENT_USER\Software\Classes\VXArchive.DarkGlass.Archive]
@="VXArchive Compressed File"

[HKEY_CURRENT_USER\Software\Classes\VXArchive.DarkGlass.Archive\DefaultIcon]
@="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\VXArchive.DarkGlass.Archive\shell\open\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" \"%1\""

; Cascaded Context Menu on Files
[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive]
"MUIVerb"="VXArchive"
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\Add]
"MUIVerb"="Add to archive with VXArchive..."
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\Add\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" -az \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\ExtractHere]
"MUIVerb"="Extract here"
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\ExtractHere\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" -x \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\ExtractSubfolder]
"MUIVerb"="Extract to subfolder"
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\VXArchive\shell\ExtractSubfolder\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" -xd \"%1\""

; Cascaded Context Menu on Folders
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\VXArchive]
"MUIVerb"="VXArchive"
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\VXArchive\shell\Add]
"MUIVerb"="Add to archive with VXArchive..."
"Icon"="D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe,0"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\VXArchive\shell\Add\command]
@="\"D:\\Project FIX\\VXarchive\\dist\\VXArchive\\VXArchive.exe\" -az \"%1\""
